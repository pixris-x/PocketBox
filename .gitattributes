# 统一 LF 换行，避免 Windows 下 core.autocrlf 把整文件变成 CRLF diff
* text=auto eol=lf

# .NET 源码保持 CRLF（dotnet new 的默认，也是工具链的惯例）
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.xdb binary
